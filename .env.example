# Copiá a .env.local (desarrollo) o a /home/ubuntu/liga-web/.env (servidor).
# Valores en Supabase -> Project Settings -> API y -> Database.

# URL del proyecto Supabase, ej: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (segura para el navegador, respeta RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role / secret key (SOLO servidor, NUNCA se expone al cliente)
SUPABASE_SERVICE_ROLE_KEY=

# Emails con acceso total y gestión de permisos (separados por coma).
# Mientras esté vacío: cualquier usuario logueado tiene acceso total (modo compat).
# Al setearlo: solo estos + los que tengan permisos asignados pueden editar.
SUPERADMIN_EMAILS=

# Opcional. Si está, el workflow de GitHub Actions corre la migración
# (supabase/migrations/0001_init.sql) en cada push. Idempotente.
# Supabase -> Project Settings -> Database -> Connection string -> URI
SUPABASE_DB_URL=

# Clave para el endpoint /api/import/classification (importador de telemetría F1 25).
# Inventá una cadena larga y aleatoria. El script importador la manda como
# Authorization: Bearer <IMPORT_TOKEN>. Vacío = endpoint deshabilitado.
IMPORT_TOKEN=

# Clave fija para las Server Actions de Next (IDs estables entre builds).
# Generá una vez con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# y NO la cambies (si la cambiás, las pestañas abiertas dejan de funcionar hasta refrescar).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
