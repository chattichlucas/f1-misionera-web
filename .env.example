# Copiá este archivo a .env.local y completá los valores desde el panel de Supabase
# (Project Settings -> API).

# URL del proyecto Supabase, ej: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (segura para el navegador, respeta RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key (SOLO servidor, NUNCA se expone al cliente).
# Se usa en el panel admin para operaciones privilegiadas puntuales.
SUPABASE_SERVICE_ROLE_KEY=
